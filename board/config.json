{
  "config_version": 2,
  "reports_dir": "reports",
  "hard_block": {
    "paths": [
      "docs/DECISIONS.md",
      "docs/VISION.md"
    ],
    "dirs": [],
    "patterns": [
      "os\\.kill",
      "killpg",
      "pkill",
      "kill -"
    ]
  },
  "tests": {
    "adapter": "unittest",
    "unittest": {
      "roots": [
        "tests",
        "tests_devloop"
      ],
      "base": [
        "test_project_config",
        "test_no_project_names",
        "test_testiface"
      ],
      "map": [
        {
          "match": "devloop/*",
          "ids": [
            "test_agents_quota",
            "test_board_dag",
            "test_board_decide",
            "test_board_server",
            "test_board_stats",
            "test_board_tickets",
            "test_chain",
            "test_chain_view",
            "test_controller",
            "test_group_choice",
            "test_group_members",
            "test_groups",
            "test_issuer",
            "test_live",
            "test_machine",
            "test_memory",
            "test_opener",
            "test_pages",
            "test_pool_git",
            "test_regression_fixer",
            "test_release"
          ]
        },
        {
          "match": "tests_devloop/*",
          "ids": [
            "test_agents_quota",
            "test_board_dag",
            "test_board_decide",
            "test_board_server",
            "test_board_stats",
            "test_board_tickets",
            "test_chain",
            "test_chain_view",
            "test_controller",
            "test_group_choice",
            "test_group_members",
            "test_groups",
            "test_issuer",
            "test_live",
            "test_machine",
            "test_memory",
            "test_opener",
            "test_pages",
            "test_pool_git",
            "test_regression_fixer",
            "test_release"
          ]
        },
        {
          "match": "scripts/release.sh",
          "ids": [
            "test_agents_quota",
            "test_board_dag",
            "test_board_decide",
            "test_board_server",
            "test_board_stats",
            "test_board_tickets",
            "test_chain",
            "test_chain_view",
            "test_controller",
            "test_group_choice",
            "test_group_members",
            "test_groups",
            "test_issuer",
            "test_live",
            "test_machine",
            "test_memory",
            "test_opener",
            "test_pages",
            "test_pool_git",
            "test_regression_fixer",
            "test_release"
          ]
        },
        {
          "match": "bin/actl",
          "ids": [
            "test_project_config",
            "test_actl"
          ]
        },
        {
          "match": "scripts/project_config.py",
          "ids": [
            "test_project_config",
            "test_project_config_cases"
          ]
        },
        {
          "match": "scripts/testiface.py",
          "ids": [
            "test_testiface",
            "test_agents_quota",
            "test_board_dag",
            "test_board_decide",
            "test_board_server",
            "test_board_stats",
            "test_board_tickets",
            "test_chain",
            "test_chain_view",
            "test_controller",
            "test_group_choice",
            "test_group_members",
            "test_groups",
            "test_issuer",
            "test_live",
            "test_machine",
            "test_memory",
            "test_opener",
            "test_pages",
            "test_pool_git",
            "test_regression_fixer",
            "test_release"
          ]
        },
        {
          "match": "scripts/adapter-unittest.py",
          "ids": [
            "test_adapter_unittest",
            "test_adapter_cases",
            "test_testiface"
          ]
        },
        {
          "match": "scripts/status.py",
          "ids": [
            "test_testiface",
            "test_adapter_unittest"
          ]
        },
        {
          "match": "scripts/event.py",
          "ids": [
            "test_testiface",
            "test_adapter_unittest"
          ]
        },
        {
          "match": "scripts/session-hook.sh",
          "ids": [
            "test_actl"
          ]
        },
        {
          "match": "tests/control_harness.py",
          "ids": [
            "test_project_config",
            "test_adapter_unittest"
          ]
        },
        {
          "match": "tests/fixtures/project/*",
          "ids": [
            "test_testiface",
            "test_no_project_names"
          ]
        },
        {
          "match": "templates/project-*",
          "ids": [
            "test_no_project_names"
          ]
        },
        {
          "match": "*.md",
          "ids": [
            "test_no_project_names"
          ]
        }
      ]
    }
  },
  "devloop": {
    "memory": "memory",
    "pool_branch": "pool/agent-control",
    "release": "sh scripts/release.sh",
    "required_fields": {
      "vision": "which item of docs/VISION.md and which of its four metrics this ticket improves, and roughly by how much",
      "removes": "which gate, rule or step this ticket removes (VISION: add one, remove one); 'none' only with the reason"
    }
  }
}
