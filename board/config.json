{
  "port": 18905,
  "tickets_dir": "tickets",
  "events_file": "board/events.jsonl",
  "answers_file": "board/answers.jsonl",
  "reports_dir": "reports",
  "health_urls": {},
  "routing": {
    "main": "fable",
    "open": "fable",
    "design": "fable",
    "bug": "fable",
    "implement": "codex:gpt-5.6-sol",
    "implement_browser": "opus",
    "verify": "sonnet",
    "second_opinion": "agy:gemini-3.8-flash-high",
    "discuss": "agy:gemini-3.8-flash-high"
  },
  "memory": {
    "unit": "chars",
    "cap_chars": 2000,
    "consolidator": "fable",
    "raise_allowed": true,
    "applies_to": [
      "memory/model/*.md",
      "memory/role/*.md",
      "memory/project/*.md"
    ],
    "inbox_suffix": ".inbox.md",
    "consolidators": [
      "fable",
      "codex:gpt-6-astra"
    ]
  },
  "lease_seconds": {
    "opener": 900,
    "verifier": 3600,
    "land": 1800,
    "worker": 7200
  },
  "flaky_threshold": 3,
  "flake_auto_single_runs": 5,
  "flake_auto_group_runs": 1,
  "flaky_auto_ticket": true,
  "worker": {
    "command": "claude -p --model opus",
    "timeout_seconds": 3600
  },
  "apply": {
    "regen_cmd": ""
  }
}
