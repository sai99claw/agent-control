{
  "config_version": 2,
  "main_branch": "main",
  "tickets_dir": "tickets",
  "reports_dir": "reports",
  "hard_block": {
    "paths": [
      "docs/DECISIONS.md"
    ],
    "dirs": [],
    "patterns": []
  },
  "tests": {
    "adapter": "unittest",
    "preflight": "sh scripts/ac-tests.sh preflight",
    "select": "sh scripts/ac-tests.sh select",
    "run": "sh scripts/ac-tests.sh run",
    "full": null,
    "regression": null,
    "unittest": {
      "roots": [
        "tests",
        "demo/tests"
      ]
    },
    "timeout_seconds": {
      "run": 1200,
      "full": 3600
    }
  }
}
